diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -15,6 +15,8 @@
 # phys_gjk.cpp specific flag (experimental)
-set_source_files_properties(
-    "${SRC_DIR}/physics/phys_gjk.cpp"
