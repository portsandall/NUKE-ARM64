diff --git a/src/nuke/bd_byte_buffer_compat.h b/src/nuke/bd_byte_buffer_compat.h
new file mode 100644
--- /dev/null
+++ b/src/nuke/bd_byte_buffer_compat.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace nuke
+{
+inline std::uint32_t boundedCStringLength(const char* buffer,
+                                         std::uint32_t limit) noexcept
+{
+    const auto* terminator = static_cast<const char*>(
+        std::memchr(buffer, '\0', static_cast<std::size_t>(limit)));
+    if (terminator == nullptr)
+        return limit;
+    return static_cast<std::uint32_t>(terminator - buffer);
+}
+} // namespace nuke
